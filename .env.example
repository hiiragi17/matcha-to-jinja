# Rails API のベースURL（開発時は localhost:3001 / 本番は API ドメイン）
NEXT_PUBLIC_API_URL=http://localhost:3001

# Rails API のモック / 実 API 切替。
#   "true"   → src/lib/api/mock を使う（Rails 未起動でフロント開発できる）
#   "false"  → NEXT_PUBLIC_API_URL に対して実 fetch を行う
# 実 API 連携時（読み取り系 #49 / 認証 #50 / 書き込み #51）は "false" にする。
# 詳細は docs/local-setup.md を参照。
NEXT_PUBLIC_USE_MOCK=true

# Google Maps（#22 現在地検索で使用）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID（Cloud Console で発行。Advanced Markers の利用に必要。未設定時は DEMO_MAP_ID）
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# NextAuth.js / Auth.js v5（#23 認証で使用）
# 旧 NEXTAUTH_* 名でも互換動作するが、v5 では AUTH_* を推奨。
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth プロバイダー（未設定の場合は開発用モックログインが表示される）
# 設定すると NextAuth の OAuth フローが有効化され、認証成功時に Rails の
# POST /api/v1/auth/:provider と access_token を交換して Rails 発行の JWT を
# session.railsJwt に格納する（#50 実装）。Rails 側の OAuth コンシューマー設定
# （callback URL / client_id・secret）と同じ値を使うこと。
# Google は Rails と同一の GCP OAuth クライアントを共有し、リダイレクト URI に
# /api/auth/callback/google（Next.js 側）を追加しておくこと。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=
